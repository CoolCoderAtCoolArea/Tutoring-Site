{
  "name": "detroit-tutoring-site",
  "version": "1.0.0",
  "private": true,
  "description": "Free tutoring website for K-12 students and families in Detroit, MI",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
