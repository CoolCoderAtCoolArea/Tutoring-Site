# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local. NEVER share the SERVICE ROLE key.

# --- Supabase (Project Settings -> API) ---
# Safe to expose in the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SECRET. Server only. Bypasses Row Level Security. Used for creating student
# logins, grading quizzes, sending emails, and deleting family data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Website address (no slash at the end) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email via Resend (resend.com, free tier) ---
# Leave RESEND_API_KEY empty while testing: emails are printed to the terminal instead.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend.
EMAIL_FROM="Detroit Learning Club <hello@example.org>"

# --- Secret used by the hourly reminder job. Make up a long random string. ---
CRON_SECRET=change-me-to-a-long-random-string

# --- Optional: Cloudflare Turnstile spam check (leave empty to turn off) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
